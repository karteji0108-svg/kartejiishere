rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (getUserData().role == role || request.auth.token.role == role);
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isKetua() {
      return hasRole('ketua');
    }

    function isWakil() {
      return hasRole('wakil_ketua');
    }

    function isBendahara() {
      return hasRole('bendahara');
    }

    function isSekretaris() {
      return hasRole('sekretaris');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Rules ---

    // Users Collection
    match /users/{userId} {
      // Anyone authenticated can read user profiles (for member lists)
      allow read: if isAuthenticated();

      // Creation:
      // 1. User signing up can create their own profile BUT must not set elevated role
      // 2. Admins/Sekretaris can create users with any role (within reason, but for simplicity any)
      allow create: if (isOwner(userId) && request.resource.data.role == 'anggota') || isSuperAdmin() || isSekretaris();

      // Update:
      // 1. Owner can update their own profile BUT cannot change their role
      // 2. Super Admin can update anyone and any field
      // 3. Sekretaris can update members (for management)
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isSuperAdmin() || isSekretaris();

      // Delete: Only Super Admin
      allow delete: if isSuperAdmin();
    }

    // Finance Collection
    match /finance/{document=**} {
      // Read: Authenticated users (transparency)
      allow read: if isAuthenticated();

      // Write: Bendahara and Super Admin only
      allow write: if isBendahara() || isSuperAdmin();
    }

    // Activities Collection
    match /activities/{document=**} {
      // Public read
      allow read: if true;

      // Create: Authenticated users can propose (create with status 'pending' ideally)
      // For now, allow create if authenticated, but maybe enforce status in future.
      allow create: if isAuthenticated();

      // Update/Delete: Officers only
      allow update, delete: if isSuperAdmin() || isKetua() || isWakil() || isSekretaris();
    }

    // Announcements Collection
    match /announcements/{document=**} {
      allow read: if true;
      // Write: Sekretaris, Ketua, Wakil, Super Admin
      allow write: if isSuperAdmin() || isKetua() || isWakil() || isSekretaris();
    }

    // Gallery Collection
    match /gallery/{document=**} {
      allow read: if true;
      // Write: Authenticated users (members) can upload, but delete restricted
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() || isSekretaris();
    }

    // Hero Slides Collection (NEW)
    match /hero_slides/{document=**} {
      // Read: Everyone (it's a hero banner)
      allow read: if true;

      // Write: Super Admin, Ketua, Wakil Ketua
      allow write: if isSuperAdmin() || isKetua() || isWakil();
    }
  }
}
