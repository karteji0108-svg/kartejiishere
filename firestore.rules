rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (getUserData().role == role || request.auth.token.role == role);
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isKetua() {
      return hasRole('ketua');
    }

    function isWakil() {
      return hasRole('wakil_ketua');
    }

    function isBendahara() {
      return hasRole('bendahara');
    }

    function isSekretaris() {
      return hasRole('sekretaris');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Rules ---

    // Users Collection
    match /users/{userId} {
      // Anyone authenticated can read user profiles (for member lists)
      allow read: if isAuthenticated();

      // Creation:
      // 1. User signing up can create their own profile (with restricted fields preferably, but open for now)
      // 2. Admins/Sekretaris can create users
      allow create: if isOwner(userId) || isSuperAdmin() || isSekretaris();

      // Update:
      // 1. Owner can update their own profile
      // 2. Super Admin can update anyone
      // 3. Sekretaris can update members (for management)
      allow update: if isOwner(userId) || isSuperAdmin() || isSekretaris();

      // Delete: Only Super Admin
      allow delete: if isSuperAdmin();
    }

    // Finance Collection
    match /finance/{document=**} {
      // Read: Authenticated users (transparency) or restricted to specific roles?
      // Requirement says "Bendahara manage", "Ketua monitor". Let's allow Auth read for transparency.
      allow read: if isAuthenticated();

      // Write: Bendahara and Super Admin only
      allow write: if isBendahara() || isSuperAdmin();
    }

    // Activities Collection
    match /activities/{document=**} {
      // Public read
      allow read: if true;

      // Write: Sekretaris, Ketua, Wakil, Super Admin
      // Anggota can "Propose" -> typically this means create with status='pending'
      allow create: if isAuthenticated();

      // Update/Delete: Officers only
      allow update, delete: if isSuperAdmin() || isKetua() || isWakil() || isSekretaris();
    }

    // Announcements Collection
    match /announcements/{document=**} {
      allow read: if true;
      // Write: Sekretaris, Ketua, Wakil, Super Admin
      allow write: if isSuperAdmin() || isKetua() || isWakil() || isSekretaris();
    }

    // Gallery Collection
    match /gallery/{document=**} {
      allow read: if true;
      // Write: Sekretaris, Super Admin
      allow write: if isSuperAdmin() || isSekretaris();
    }
  }
}
