rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
         request.auth.token.role == 'super_admin');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    // - Authenticated users can read their own profile.
    // - Super Admins can read/write everything.
    // - New users can create their own profile (signup).
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId); // User creating their own profile
      allow update: if isOwner(userId) || isSuperAdmin(); // User updating self or Admin updating user
      allow delete: if isSuperAdmin();
    }

    // Finance Collection
    // - Only Super Admins (Bendahara/Ketua) should ideally write here.
    // - For this app context, we'll allow Super Admins full access.
    // - Authenticated users might need read access if they are members.
    match /finance/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Activities Collection
    // - Public read (or auth read).
    // - Write restricted to Admins.
    match /activities/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Announcements Collection
    // - Public read (or auth read).
    // - Write restricted to Admins.
    match /announcements/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Gallery Collection
    // - Public read.
    // - Write restricted to Admins.
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
